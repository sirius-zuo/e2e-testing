{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:e2e-testing:protocol:1.0",
  "title": "E2E Testing Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "run_id", "revision", "mode", "autonomy", "status",
    "project", "target", "journeys", "tests", "evidence", "conflicts",
    "attempt_budget", "attempt_history", "handoffs", "authorizations", "next_actions"
  ],
  "properties": {
    "protocol_version": {"const": "1.0"},
    "run_id": {"type": "string", "pattern": "^run-[a-z0-9-]+$"},
    "revision": {"type": "integer", "minimum": 0},
    "mode": {"enum": ["plan", "generate", "verify", "repair"]},
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "auto_repair"],
      "properties": {
        "mode": {"enum": ["explicit", "auto"]},
        "auto_repair": {"type": "boolean"}
      }
    },
    "status": {
      "enum": [
        "initialized", "planned", "ready-for-adapter", "generated-unverified",
        "verifying", "repair-ready", "handoff-required", "needs-clarification",
        "needs-authorization", "verified", "blocked", "unsupported-framework",
        "protocol-incompatible"
      ]
    },
    "project": {
      "type": "object",
      "required": ["root"],
      "properties": {"root": {"type": "string"}, "framework": {"type": ["string", "null"]}},
      "additionalProperties": true
    },
    "target": {
      "type": "object",
      "required": ["tier", "base_url_ref"],
      "properties": {
        "tier": {"enum": ["local", "ephemeral", "staging", "production", "unspecified"]},
        "base_url_ref": {"type": ["string", "null"]},
        "credentials_ref": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "journeys": {"type": "array", "items": {"$ref": "#/$defs/trackedItem"}},
    "tests": {"type": "array", "items": {"$ref": "#/$defs/testItem"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "attempt_budget": {
      "type": "object",
      "required": ["repair", "verification", "wall_clock_seconds"],
      "properties": {
        "repair": {"type": "integer", "minimum": 0},
        "verification": {"type": "integer", "minimum": 1},
        "wall_clock_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "attempt_history": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "handoffs": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "authorizations": {"type": "array", "items": {"$ref": "#/$defs/idObject"}},
    "next_actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}
  },
  "$defs": {
    "idObject": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}, "additionalProperties": true},
    "trackedItem": {"type": "object", "required": ["id", "status"], "properties": {"id": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": true},
    "testItem": {"type": "object", "required": ["id", "journey_id", "status"], "properties": {"id": {"type": "string"}, "journey_id": {"type": "string"}, "status": {"type": "string"}}, "additionalProperties": true},
    "action": {"type": "object", "required": ["id", "capability", "journey_ids"], "properties": {"id": {"type": "string"}, "capability": {"type": "string"}, "journey_ids": {"type": "array", "items": {"type": "string"}}, "resume": {"type": "object"}}, "additionalProperties": true}
  }
}
